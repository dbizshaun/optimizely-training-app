{
  "name": "yasplaza-hotels",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "dev": "next dev",
    "build:dev": "next build",
    "build:full": "graphql-codegen && next build",
    "build": "yarn compile && yarn build:dev",
    "start": "next start",
    "lint": "next lint",
    "compile": "graphql-codegen",
    "watch": "graphql-codegen -w",
    "webhook:create": "opti-graph webhook:create",
    "webhook:list": "opti-graph webhook:list",
    "test": "jest",
    "test:cov": "jest --coverage",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\" --ignore-path .prettierignore",
    "prepare": "husky"
  },
  "dependencies": {
    "@datadog/browser-logs": "^6.25.0",
    "@datadog/browser-rum": "^6.25.0",
    "@datadog/datadog-ci": "^4.4.0",
    "@next/third-parties": "^16.0.10",
    "@remkoj/optimizely-cms-nextjs": "^5.1.6",
    "@remkoj/optimizely-cms-react": "^5.1.6",
    "@remkoj/optimizely-graph-client": "^5.1.6",
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3",
    "entities": "^6.0.1",
    "graphql": "^16.12.0",
    "graphql-request": "^6.1.0",
    "graphql-tag": "^2.12.6",
    "next": "14.2.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/fragment-matcher": "^5.1.0",
    "@graphql-codegen/schema-ast": "^5.0.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@parcel/watcher": "^2.5.1",
    "@remkoj/optimizely-cms-api": "^5.1.6",
    "@remkoj/optimizely-cms-cli": "^5.1.6",
    "@remkoj/optimizely-graph-cli": "^5.1.6",
    "@remkoj/optimizely-graph-functions": "^5.1.6",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.2",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@yarnpkg/sdks": "^3.2.3",
    "chalk": "^5.6.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.33",
    "eslint-plugin-jest": "^29.5.0",
    "figures": "^6.1.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.17",
    "ts-jest": "29.0.0-next.1",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "@graphql-codegen/visitor-plugin-common": "file:./packages/graphql-codegen-visitor-plugin-common-v5.8.0-patched.tgz",
    "@remkoj/optimizely-cms-api": "file:./packages/@remkoj-optimizely-cms-api-v5.1.3-patched.tar.gz",
    "@remkoj/optimizely-cms-cli": "file:./packages/@remkoj-optimizely-cms-cli-v5.1.3-patched.tar.gz",
    "@remkoj/optimizely-graph-cli": "file:./packages/@remkoj-optimizely-graph-cli-v5.1.3-patched.tar.gz"
  },
  "graphql": {
    "schema": "./schema.graphql",
    "documents": "src/**/*.{graphql,js,ts,jsx,tsx}",
    "exclude": [
      "node_modules/**",
      "src/gql/**",
      ".next/**",
      "codegen.ts"
    ],
    "extensions": {
      "languageService": {
        "enableValidation": true
      }
    }
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "yarn format"
    ]
  }
}
