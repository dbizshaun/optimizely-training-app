{
  "extends": ["next/core-web-vitals", "plugin:jest/recommended"],
  "plugins": ["jest"],
  "env": {
    "jest": true
  },
  "overrides": [
    {
      "files": ["*.test.{js,jsx,ts,tsx}", "*.spec.{js,jsx,ts,tsx}"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off",
        "no-console": "off",
        "jest/expect-expect": "off"
      }
    }
  ]
}
